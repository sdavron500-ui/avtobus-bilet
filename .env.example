# Nusxa oling: .env  (yoki muhit o'zgaruvchilari sifatida bering)
PORT=3000
BRAND_NAME=Marshrut

# Admin panel paroli (/admin.html). ALBATTA o'zgartiring!
ADMIN_PASSWORD=admin123

# Xizmat yig'imi, chipta narxidan foizda
FEE_PERCENT=2

# Tanlangan o'rin necha daqiqa ushlab turiladi
HOLD_MINUTES=10

# Jo'nashga necha daqiqa qolgunicha chiptani qaytarish mumkin
RETURN_BEFORE_MIN=60

# Bitta buyurtmada eng ko'p o'rin
MAX_SEATS=5

# DEMO=1: to'lov va SMS kodlari soxta (kod 123456). Haqiqiy to'lov ulanganda 0 qiling.
DEMO=1

# Aloqa ma'lumotlari ("Aloqa" sahifasida va reys o'zgarishi xabarlarida ko'rinadi)
# SMS hozir yuborilmaydi; CONTACT_PHONE faqat qo'ng'iroq uchun ko'rsatiladi.
CONTACT_PHONE=+998 00 000 00 00
CONTACT_TELEGRAM=@username
CONTACT_EMAIL=info@example.com
CONTACT_HOURS=8:00-20:00
CONTACT_ADDRESS=

# Ma'lumotlar bazasi papkasi
DATA_DIR=./data
